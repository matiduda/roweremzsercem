---
import ClientRouter from "astro/components/ClientRouter.astro";
import "../styles/global.css";
import { siteConfig } from "@/config/site";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
}

const {
	title = siteConfig.title,
	description = siteConfig.description,
	image = siteConfig.socialImage,
	type = "website",
} = Astro.props;

const pageTitle =
	title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const defaultStructuredData = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteConfig.name,
	url: siteConfig.siteUrl,
	description: siteConfig.description,
	publisher: {
		"@type": "Organization",
		name: siteConfig.authorName,
	},
};
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link
			rel="preload"
			href="/fonts/geist/Geist-Variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<!-- HTML Meta Tags -->
		<title>{pageTitle}</title>
		<meta
			name="description"
			content='"Rowerem z Sercem" - charytatywny rajd rowerowy połączony z transmisją na żywo'
		/>

		<!-- Google / Search Engine Tags -->
		<meta itemprop="name" content="Rowerem z Sercem" />
		<meta
			itemprop="description"
			content='"Rowerem z Sercem" - charytatywny rajd rowerowy połączony z transmisją na żywo'
		/>
		<meta
			itemprop="image"
			content="https://roweremzsercem.pl/site_preview.png"
		/>

		<!-- Facebook Meta Tags -->
		<meta property="og:url" content="https://roweremzsercem.pl/" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Rowerem z Sercem" />
		<meta
			property="og:description"
			content='"Rowerem z Sercem" - charytatywny rajd rowerowy połączony z transmisją na żywo'
		/>
		<meta
			property="og:image"
			content="https://roweremzsercem.pl/site_preview.png"
		/>

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Rowerem z Sercem" />
		<meta
			name="twitter:description"
			content='"Rowerem z Sercem" - charytatywny rajd rowerowy połączony z transmisją na żywo'
		/>
		<meta
			name="twitter:image"
			content="https://roweremzsercem.pl/site_preview.png"
		/>

		<!-- Meta Tags Generated via https://heymeta.com -->
		<ClientRouter />
	</head>
	<body class="min-h-screen bg-gray-50">
		<slot />
	</body>
</html>
