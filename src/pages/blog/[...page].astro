---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostCard from "@/components/PostCard.astro";
import { visiblePosts, type Post } from "@/lib/posts";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScrollReveal from "@/components/ScrollReveal";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = visiblePosts(await getCollection("posts"));
  return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const allPosts = visiblePosts(await getCollection("posts"));
const title =
  page.currentPage === 1 ? "Blog" : `Blog - strona ${page.currentPage}`;
const withTrailingSlash = (url: string | undefined) =>
  url && !url.endsWith("/") ? `${url}/` : url;
const prevUrl = withTrailingSlash(page.url.prev);
const nextUrl = withTrailingSlash(page.url.next);
---

<Layout title={title}>
  <Header />
  <main id="content" class="max-w-6xl mx-auto p-4">
    <header class="mt-10">
      <ScrollReveal client:load delay={0}>
        <p class="text-2xl md:text-4xl font-semibold text-gray-700">Blog</p>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.1}>
        <h1 class="my-3 md:my-4 text-slate-500">
          Aktualności od ekipy "Rowerem z Sercem"
        </h1>
      </ScrollReveal>

      <ScrollReveal client:load delay={0.2}>
        <div
          class="add-dotted-spacer text-sm font-semibold text-slate-500 [--dot-border-color:var(--color-slate-500)]"
        >
          <span>
            Strona {page.currentPage} z {page.lastPage}
          </span>
          <span>
            {page.total}
            {page.total === 1 ? " post" : " postów"}
          </span>

          <span> od najnowszego </span>
        </div>
      </ScrollReveal>
    </header>

    <ScrollReveal client:load delay={0.35}>
      <hr class="h-px bg-gray-200 border-0 mt-6 mb-6" />
    </ScrollReveal>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8">
      {
        page.data.map((post, i) => (
          <ScrollReveal client:load delay={0.4 + i * 0.05}>
            <PostCard post={post} />
          </ScrollReveal>
        ))
      }
    </div>

    <nav
      class="mt-16 flex items-center justify-between gap-4 border-t border-slate-200 border-border pt-6 mb-8"
      aria-label="Archive pagination"
    >
      {
        prevUrl ? (
          <a
            href={prevUrl}
            class="text-slate-600 hover:text-slate-400 transition-colors"
          >
            <span class="">&larr;</span> Nowsze
          </a>
        ) : (
          <span class="opacity-20">&larr; Nowsze</span>
        )
      }
      <span
        class="text-xs font-semibold text-slate-400 tracking-widest text-muted-foreground uppercase"
      >
        Strona {page.currentPage} / {page.lastPage}
      </span>
      {
        nextUrl ? (
          <a
            href={nextUrl}
            class="text-slate-600 hover:text-slate-400 transition-colors"
          >
            Starsze <span class="">&rarr;</span>
          </a>
        ) : (
          <span class="opacity-20">Starsze &rarr;</span>
        )
      }
    </nav>
  </main>
  <Footer />
</Layout>
