---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import Team from "../components/Team.astro";
import Sponsors from "../components/Sponsors.astro";
import StreamEmbed from "../components/StreamEmbed.astro";
import StreamInfo from "../components/StreamInfo.astro";
import AboutUs from "../components/AboutUs.astro";
import StreamFeatures from "../components/StreamFeatures.astro";
import LatestPosts from "@/components/LatestPosts.astro";

export const isStream = () => {
  // 1 maja 2026 - 9:00 (UTC)
  return new Date().getTime() > new Date("2026-05-01T09:00:00+02:00").getTime();
};
---

<Layout>
  <Header />
  <Hero />
  <AboutUs />
  <LatestPosts />
  <!-- <Features /> -->
  <!-- <Team /> -->
  <Sponsors />
</Layout>
<Footer />
