---
import { visiblePosts } from "@/lib/posts";
import { getCollection } from "astro:content";
import ScrollReveal from "./ScrollReveal.tsx";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;
const allPosts = visiblePosts(await getCollection("posts"));

const latestPostsToDisplay = 3;

const posts = allPosts.slice(0, latestPostsToDisplay);
---

<ScrollReveal client:load delay={0.6}>
  <section class="max-w-6xl mx-auto px-4 relative mt-8 text-left mb-8">
    <div class="flex items-center gap-3">
      <h1 class="inset-0 text-2xl md:text-3xl font-bold text-gray-800">Blog</h1>
      <span
        class="text-xs uppercase bg-blue-400 border border-slate-200 text-white px-2 py-1 rounded-full"
        >Nowe</span
      >
    </div>
    <ScrollReveal client:load delay={0.7}>
      <hr class="h-px bg-gray-200 border-0 mt-6 mb-6" />
    </ScrollReveal>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-8 mb-16"
    >
      {
        posts.map((post, i) => (
          <ScrollReveal client:load delay={0.5 + i * 0.2}>
            <PostCard post={post} />
          </ScrollReveal>
        ))
      }
    </div>
    <ScrollReveal client:load delay={0.6}>
      <div class="flex flex-row gap-4 w-full justify-center">
        <a
          href="/blog"
          class="inline-block px-8 py-3 bg-white text-gray-900 border border-gray-300 rounded-xl hover:bg-gray-200 transition-colors font-medium"
        >
          Więcej postów
        </a>
      </div>
    </ScrollReveal>
  </section>
</ScrollReveal>
