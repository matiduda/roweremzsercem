---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import HeroText from "./HeroText";
---

<section class="max-w-6xl mx-auto px-4 py-4 md:py-10 text-center relative">
  <ScrollReveal client:load>
    <div class="pt-48 md:pt-96 p-8 bg-white rounded-4xl border border-gray-200">
      <!-- Background video -->
      <video
        class="absolute inset-0 h-full w-full object-cover rounded-4xl border border-gray-200 inset-shadow-sm"
        autoplay
        muted
        loop
        playsinline
      >
        <source
          src="https://i.imgur.com/wj8kvQM.mp4"
          type="video/mp4"
          id="backgroundVideoSource"
        />
      </video>
      <!-- Overlay (for contrast) -->
      <div
        class="absolute inset-0 bg-linear-to-b from-gray-500/20 to-gray-900/70 rounded-4xl"
      >
      </div>
      <ScrollReveal client:load delay={0.2}>
        <HeroText client:load />
      </ScrollReveal>
      <ScrollReveal client:load delay={0.4}>
        <p
          class="text-xl md:text-2xl text-gray-200 mb-8 mt-5 max-w-2xl text-shadow-sm text-left"
        >
          Jedziemy na rowerach, transmitujemy na żywo, razem z widzami zbieramy
          środki na realną pomoc
        </p>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.6}>
        <div class="flex flex-col sm:flex-row gap-4">
          <!-- <a
            href="https://addcal.io/e/bb5wt5ymbo1j"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex justify-center items-center gap-2 px-8 py-3 bg-rzs text-white rounded-lg hover:bg-rzs-hover transition-colors font-medium"
          >
            <Icon name="tabler:calendar-plus" class="w-5 h-5" />
            Dodaj do kalendarza
          </a> -->
          <a
            href="/info"
            class="inline-block px-8 py-3 bg-white text-gray-900 border border-gray-300 rounded-xl hover:bg-gray-200 transition-colors font-medium"
          >
            Więcej o akcji
          </a>
        </div>
      </ScrollReveal>
    </div>
  </ScrollReveal>
</section>

<script>
  //  Desktop Safari, all mobile WebKit browsers on iOS and webview iOS
  function isWebkit() {
    return "GestureEvent" in window;
  }

  if (isWebkit()) {
    document.addEventListener("astro:page-load", () => {
      const video = document.querySelector("video");

      if (!video) return;

      // Safari needs a hard reset
      video.pause();
      video.load();

      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          // autoplay might be blocked, but muted usually works
        });
      }
    });
  }
</script>
