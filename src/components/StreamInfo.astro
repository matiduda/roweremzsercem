---
import AnimatedMap from "./AnimatedMap";
import CountdownTimer from "./CountdownTimer";
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import StreamFeatures from "./StreamFeatures.astro";
---

<section id="features" class="max-w-6xl mx-auto px-4 pt-12">
  <ScrollReveal client:load delay={0.1} margin="100px">
    <h1 class="text-4xl font-bold text-gray-900 my-4 text-center">
      Rowerem z Sercem 2026 już trwa!
    </h1>
  </ScrollReveal>

  <ScrollReveal client:load delay={0.25}>
    <div class="text-xl text-center mb-6 space-y-2">
      <p class="leading-10">
        Wystartowaliśmy <span class="font-semibold">1 maja</span> o godz. <span
          class="font-semibold">9:00</span
        >.<br />Planujemy dojazd <span class="font-semibold">3 maja</span> o godz.
        <span class="font-semibold">18:00</span>
      </p>
      <div class="flex justify-center py-6 gap-4">
        <a
          href="https://tipply.pl/@roweremzsercem"
          target="_blank"
          class="px-4 py-2 bg-rzs text-white rounded-lg hover:bg-rzs-hover flex transition-colors justify-center items-center gap-2 font-medium"
        >
          <Icon name="tabler:paw" class="text-white inline w-5 h-5" />
          Wpłać na zbiórkę
        </a>
        <a
          href="https://www.instagram.com/roweremzsercem/"
          target="_blank"
          class="px-4 py-2 bg-blue-400 text-white rounded-lg hover:bg-blue-400/90 flex transition-colors justify-center items-center gap-2 font-medium"
        >
          <Icon
            name="tabler:brand-instagram"
            class="text-white inline w-5 h-5"
          />
          Śledź relację
        </a>
      </div>
      <div class="flex justify-center px-10">
        <ul class="list-disc text-left space-y-2">
          <li>Stream jest dostępny w całości za darmo</li>
          <li>Jedziemy z Sandomierza do Wrocławia, 400km</li>
          <li>
            Wszystkie środki wpłacone w trakcie transmisji wspierają <a
              class="hover:text-gray-400 transition"
              href="https://www.facebook.com/Przytulisko.na.Wisniowej/?locale=pl_PL"
              target="_blank">Przytulisko na Wiśniowej</a
            > w Sandomierzu
          </li>
        </ul>
      </div>
    </div>
  </ScrollReveal>

  <ScrollReveal client:load delay={0.4}>
    <div class="flex justify-center">
      <AnimatedMap client:load />
    </div>
  </ScrollReveal>

  <ScrollReveal client:load delay={0.25}>
    <hr class="h-px my-6 bg-gray-200 border-0" />
  </ScrollReveal>

  <StreamFeatures />
</section>
