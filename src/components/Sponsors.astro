---
import ScrollReveal from "./ScrollReveal.tsx";
import { Image } from "astro:assets";

import LogoSando from "../assets/sponsors/sando.png";
import FHUCyklistaLogo from "../assets/sponsors/fhu_cyklista.png";
import PrzytuliskoLogo from "../assets/sponsors/przytulisko.png";

const sponsors = [
  {
    name: "Urząd Miasta Sandomierz",
    image: LogoSando,
    href: "https://sandomierz.eu/",
  },
  {
    name: "FHU Cyklista Sklep i Serwis",
    image: FHUCyklistaLogo,
    href: "https://sklepcyklista.pl/",
  },
  {
    name: "Przytulisko na Wiśniowej",
    image: PrzytuliskoLogo,
    href: "https://www.facebook.com/Przytulisko.na.Wisniowej/",
  },
];
---

<section id="features" class="max-w-6xl mx-auto p-4">
  <ScrollReveal client:load delay={0.3}>
    <hr class="h-px mt-0 bg-gray-200 border-0 mb-6" />
  </ScrollReveal>

  <ScrollReveal client:load delay={0.4}>
    <div class="flex justify-center">
      <div class="flex gap-6">
        {
          sponsors.map((sponsor, i) => (
            <a
              href={sponsor.href}
              title={sponsor.name}
              class="grayscale opacity-75 hover:opacity-100 transition-opacity duration-200"
            >
              <div class="w-full flex justify-center p-4 mb-2">
                <Image
                  alt={`${sponsor.name}`}
                  src={sponsor.image}
                  alt={sponsor.name}
                  class="h-16 md:h-18 w-auto"
                />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </ScrollReveal>
</section>
