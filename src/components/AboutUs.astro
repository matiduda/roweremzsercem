---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import HeroText from "./HeroText";
import AboutUsFeatures from "./AboutUsFeatures.astro";
---

<ScrollReveal client:load delay={0.4}>
  <section class="max-w-6xl mx-auto px-4 text-center relative mt-8">
    <h1
      class="inset-0 text-4xl md:text-5xl font-bold text-gray-800 text-center"
    >
      Rowerem z Sercem
    </h1>
    <ScrollReveal client:load delay={0.5}>
      <p class="text-gray-600 text-lg text-center py-8">
        Oddolna inicjatywa, w ramach której organizujemy charytatywny rajd
        rowerowy połączony z transmisją na żywo.
      </p>
    </ScrollReveal>
    <AboutUsFeatures />
  </section>
</ScrollReveal>
